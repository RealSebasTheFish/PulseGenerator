`timescale 1 ps/ 1 ps

module pulseController (
	clk50,
	rb_clk,
	usb_rx,
	usb_tx,
	trig,
	clkled,
	startled,
	trigled,
	channel,
	led,
	led_arr);
input 	clk50;
input 	rb_clk;
input 	usb_rx;
output 	usb_tx;
input 	trig;
output 	clkled;
output 	startled;
output 	trigled;
output 	[3:0] channel;
output 	led;
output 	[7:0] led_arr;

