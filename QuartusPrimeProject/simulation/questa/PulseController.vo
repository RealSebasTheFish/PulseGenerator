`timescale 1 ps/ 1 ps

module pulseController (
	clk50,
	usb_rx,
	usb_tx,
	trig,
	clkled,
	startled,
	trigled,
	channel,
	led);
input 	clk50;
input 	usb_rx;
output 	usb_tx;
input 	trig;
output 	clkled;
output 	startled;
output 	trigled;
output 	[3:0] channel;
output 	led;

// Design Ports Information
// usb_tx	=>  Location: PIN_P12,	 I/O Standard: 2.5 V,	 Current Strength: Default
// clkled	=>  Location: PIN_AA3,	 I/O Standard: 2.5 V,	 Current Strength: Default
// startled	=>  Location: PIN_E11,	 I/O Standard: 2.5 V,	 Current Strength: Default
// trigled	=>  Location: PIN_T19,	 I/O Standard: 2.5 V,	 Current Strength: Default
// channel[0]	=>  Location: PIN_H11,	 I/O Standard: 2.5 V,	 Current Strength: Default
// channel[1]	=>  Location: PIN_C7,	 I/O Standard: 2.5 V,	 Current Strength: Default
// channel[2]	=>  Location: PIN_E10,	 I/O Standard: 2.5 V,	 Current Strength: Default
// channel[3]	=>  Location: PIN_C8,	 I/O Standard: 2.5 V,	 Current Strength: Default
// led	=>  Location: PIN_V13,	 I/O Standard: 2.5 V,	 Current Strength: Default
// clk50	=>  Location: PIN_R11,	 I/O Standard: 2.5 V,	 Current Strength: Default
// trig	=>  Location: PIN_T18,	 I/O Standard: 2.5 V,	 Current Strength: Default
// usb_rx	=>  Location: PIN_AB15,	 I/O Standard: 2.5 V,	 Current Strength: Default


