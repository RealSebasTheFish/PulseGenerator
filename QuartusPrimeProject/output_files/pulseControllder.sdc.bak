# ============================================================
# Base input clocks (adjust periods if different)
# ============================================================
create_clock -name clk50   -period 20.000  [get_ports clk50]    ;# 50 MHz
create_clock -name rb_clk  -period 100.000 [get_ports rb_clk]   ;# 10 MHz if that's what rb_clk is (EDIT!)

# ============================================================
# Generated clocks from PLLs
# IMPORTANT: these must point at the PLL output pins as seen by TimeQuest
# Use: Report Clocks -> find exact node names
# ============================================================

